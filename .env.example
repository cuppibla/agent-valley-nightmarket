# How this lab talks to Gemini: Vertex AI, on your own Google Cloud project.
# Nothing to paste, nothing to leak. In Cloud Shell you are already signed in,
# so this is all it takes:
#
#   gcloud auth application-default login     # not needed in Cloud Shell
#   gcloud config set project YOUR_PROJECT_ID
#
# Leave the line below as-is and the lab picks up that project on its own.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id      # only if gcloud isn't already set
#
# Vertex serves its live models from regions, not from `global`. The lab's model
# is in us-central1, us-east5 and europe-west4.
# GOOGLE_CLOUD_LOCATION=us-central1
#
# An AI Studio key will not open this line: the lab's live model,
# gemini-live-2.5-flash-native-audio, is a Vertex AI model.

# ── the tower (chapter 5) ─────────────────────────────────────────────────────
# Vertex AI Memory Bank lives on an Agent Engine. If you did week four, paste
# the AGENT_ENGINE line from that lab's .env here — Nix and Vesper then share one
# tower. Otherwise `uv run python scripts/make_tower.py` builds one and writes
# the line for you. Needs a project with billing; an AI Studio key alone cannot
# reach Memory Bank. The Night Market re-reads this file on every call.
# AGENT_ENGINE=projects/…/locations/us-central1/reasoningEngines/…
# MEMORY_BANK_LOCATION=us-central1
